# Sarvam AI (TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# Deepgram (STT)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenRouter (LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# TTS Settings
SARVAM_TTS_VOICE=anushka
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SAMPLE_RATE=22050

# LLM Settings
LLM_SYSTEM_PROMPT=You are a helpful, friendly AI assistant. Keep responses concise and conversational — aim for 1-3 sentences unless the user asks for detail.

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173
