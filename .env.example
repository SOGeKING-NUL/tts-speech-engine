# ============================================
# TTS Speech Engine — Environment Variables
# ============================================
# Copy the relevant sections into:
#   server/.env   (backend)
#   client/.env   (frontend)

# ─── Sarvam AI (STT + TTS) ───────────────────
# Sign up & get your key: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# ─── Google Gemini (LLM) ─────────────────────
# Get your key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ─── TTS Settings ────────────────────────────
SARVAM_TTS_VOICE=anushka
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v2
# bulbul:v2 native rate is 22050; bulbul:v3 is 24000
SARVAM_TTS_SAMPLE_RATE=22050

# ─── STT Settings ────────────────────────────
SARVAM_STT_LANGUAGE=en-IN
SARVAM_STT_MODEL=saaras:v3

# ─── LLM Settings ────────────────────────────
LLM_MODEL=gemini-2.5-flash
LLM_SYSTEM_PROMPT=You are a helpful, friendly AI assistant. Keep responses concise and conversational — aim for 1-3 sentences unless the user asks for detail.

# ─── Server ──────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# ─── Client (prefix with VITE_ for Vite) ────
VITE_WS_URL=ws://localhost:8000/ws/voice
